{
  "name": "nightlight-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Nightlight: the Ring doorbell works the night shift for families living with dementia. Every door alarm wakes the caregiver; Nightlight lets them sleep.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "infra"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b packages/engine packages/ring-webhook-kit packages/simulator apps/backend",
    "demo": "npm run demo -w @nightlight/backend",
    "dev": "npm run dev -w @nightlight/backend",
    "web:dev": "npm run dev -w @nightlight/web",
    "web:build": "npm run build -w @nightlight/web"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "aws-cdk": "^2.1139.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
