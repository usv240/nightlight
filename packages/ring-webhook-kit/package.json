{
  "name": "ring-webhook-kit",
  "version": "0.1.1",
  "description": "Verified intake for Ring Partner API webhooks: HMAC SHA-256 signature verification, typed event payloads, and idempotent deduplication. Framework-agnostic, zero dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "ring",
    "webhook",
    "hmac",
    "amazon-vision",
    "smart-home"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "tsc -b",
    "prepublishOnly": "tsc -b"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usv240/nightlight.git",
    "directory": "packages/ring-webhook-kit"
  },
  "homepage": "https://github.com/usv240/nightlight/tree/main/packages/ring-webhook-kit",
  "bugs": {
    "url": "https://github.com/usv240/nightlight/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
